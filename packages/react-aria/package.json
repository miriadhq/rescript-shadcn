{
  "name": "rescript-react-aria",
  "version": "1.19.1",
  "description": "ReScript bindings for React Aria Components",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": {
    "name": "tsnobip",
    "url": "https://github.com/tsnobip"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tsnobip/rescript-shadcn-ui.git",
    "directory": "packages/react-aria"
  },
  "keywords": [
    "components",
    "react-aria",
    "rescript",
    "bindings"
  ],
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rescript": "^13.0.0-alpha.5"
  },
  "devDependencies": {
    "@juspay/rescript-bindgen": "1.2.4",
    "@rescript/react": "^0.16.0-beta.1"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.2",
    "@rescript/react": "^0.16.0-beta.1",
    "react-aria-components": "^1.19.0"
  },
  "scripts": {
    "bindings:audit": "rescript-bindgen --pkg react-aria-components@1.19.0 --no-install --node-modules ../../node_modules --from react-aria-components --out .bindgen-audit --clean --report --json-summary .bindgen-audit/summary.json --no-webapi --yes",
    "res:build": "rescript",
    "res:clean": "rescript clean",
    "res:dev": "rescript watch"
  }
}
