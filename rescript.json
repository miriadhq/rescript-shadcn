{
  "name": "rescript-shadcn",
  "namespace": true,
  "sources": [
    {
      "dir": "app",
      "subdirs": true
    },
    {
      "dir": "src",
      "subdirs": true
    }
  ],
  "jsx": {
    "version": 4
  },
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "suffix": ".res.mjs",
  "dependencies": [
    "@rescript/react",
    "@rescript/webapi",
    "rescript-base-ui",
    "rescript-react-aria",
    "rescript-shadcn-base",
    "rescript-shadcn-aria",
    "rescript-shadcn-react",
    "rescript-signals"
  ],
  "compiler-flags": [
    "-open Base"
  ],
  "reanalyze": {
    "analysis": [
      "dce",
      "exception"
    ]
  }
}
