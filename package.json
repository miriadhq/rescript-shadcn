{
  "name": "rescript-shadcn",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "registry/base",
    "registry/aria"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "yarn loader:generate && yarn compile && next dev",
    "compile": "yarn workspace rescript-shadcn-base res:build && yarn workspace rescript-shadcn-aria res:build && yarn rescript",
    "build": "yarn loader:generate && yarn compile && yarn registry:sync && node scripts/build-with-og.mjs",
    "build:next": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "registry:sync": "yarn registry:generate && rm -rf public/r .registry-build && yarn registry:build",
    "registry:build": "node scripts/build-style-registries.mjs",
    "registry:generate": "node scripts/generate-registry.mjs",
    "loader:generate": "node scripts/generate-demo-loader.mjs",
    "og:generate": "node scripts/generate-og-images.mjs",
    "test:docs": "vitest run test/mdx-links.test.ts",
    "test:props": "yarn compile && vitest run test/*props.test.ts test/prop-forwarding.test.ts test/base-button-types.test.ts",
    "test:classnames": "vitest run test/classname-parity.test.ts",
    "test:registry": "vitest run test/lib-style-registry.test.ts",
    "test:bindings": "yarn workspace rescript-base-ui res:build && vitest run test/react-aria-bindings.test.ts test/base-ui-bindings.test.ts",
    "test:interactions": "yarn compile && vitest run test/component-interactions.test.ts",
    "test:visual": "node test/visual/run-pixel-perfect.mjs",
    "test:visual-fast:base": "node test/visual/run-visual-fast.mjs --variant base",
    "test:visual-fast:aria": "node test/visual/run-visual-fast.mjs --variant aria",
    "test:visual-fast": "yarn test:visual-fast:base && yarn test:visual-fast:aria",
    "test": "yarn test:docs && yarn test:props && yarn test:classnames && yarn test:registry && yarn test:bindings && yarn test:interactions && yarn test:visual",
    "postInstall": "yarn loader:generate && fumadocs-mdx source.config.mjs .source"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.0-canary.162",
    "@base-ui/react": "1.8.0",
    "@internationalized/date": "^3.12.4",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@rescript/react": "^0.15.0",
    "@rescript/webapi": "0.1.0-experimental-127e19a",
    "@shadcn/helpers": "0.2.0",
    "@shadcn/react": "0.3.1",
    "@streamdown/code": "^1.1.1",
    "@tabler/icons-react": "^3.38.0",
    "@tanstack/ai": "0.40.0",
    "@tanstack/ai-client": "0.20.0",
    "@tanstack/ai-react": "0.16.4",
    "@tanstack/react-table": "^9.0.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "7.0.0-canary.159",
    "chrono-node": "^2.9.0",
    "cmdk": "^1.1.1",
    "cn": "^0.2.2",
    "date-fns": "^4.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.6.14",
    "fumadocs-docgen": "^3.0.8",
    "fumadocs-mdx": "^14.2.9",
    "fumadocs-ui": "^16.6.14",
    "input-otp": "^1.4.2",
    "lru-cache": "^11.2.6",
    "lucide-react": "^0.487.0",
    "motion": "^12.12.1",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-aria-components": "1.21.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-is": "^19.2.4",
    "react-resizable-panels": "^4.7.1",
    "react-textarea-autosize": "^8.5.9",
    "recharts": "^3.8.0",
    "rehype-pretty-code": "^0.14.3",
    "rescript": "^12.3.0",
    "rescript-base-ui": "workspace:^",
    "rescript-react-aria": "workspace:^",
    "rescript-shadcn-aria": "workspace:^",
    "rescript-shadcn-base": "workspace:^",
    "rescript-shadcn-react": "workspace:^",
    "rescript-signals": "^1.3.4",
    "shadcn": "^3.0.0",
    "shiki": "^4.0.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tw-animate-css": "^1.3.6",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^143.0.4",
    "@tailwindcss/postcss": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "puppeteer": "^24.40.0",
    "puppeteer-core": "^24.40.0",
    "radix-ui": "^1.4.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "vitest": "^4.0.18",
    "zod": "^3.25.76"
  },
  "packageManager": "yarn@4.13.0"
}
